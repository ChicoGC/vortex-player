<?xml version="1.0" encoding="utf-8"?>
<!-- Colors come from the theme at runtime: see the android:tag tokens and Styler.kt -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.example.vortex_player.AmbientView
        android:id="@+id/libraryAmbient"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Biblioteca -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp">

            <ImageView
                android:id="@+id/appLogo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Vortex"
                android:scaleType="fitCenter" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:letterSpacing="-0.01"
                android:tag="text"
                android:text="Vortex"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnPickFolder"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@null"
                android:contentDescription="Escolher pasta"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_folder"
                android:tag="pill icon" />

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="10dp"
                android:background="@null"
                android:contentDescription="Aparência"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_settings"
                android:tag="pill icon" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="-0.02"
            android:paddingStart="20dp"
            android:paddingTop="14dp"
            android:paddingEnd="20dp"
            android:tag="text"
            android:text="Biblioteca"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/folderName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:singleLine="true"
            android:tag="text2"
            android:text="Nenhuma pasta escolhida"
            android:textSize="15sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1">

            <FrameLayout
                android:id="@+id/listCard"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:tag="glass:28"
                android:visibility="gone">

                <ListView
                    android:id="@+id/songList"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:divider="@null"
                    android:listSelector="@android:color/transparent"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:scrollbars="none" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_music"
                    android:tag="icon2" />

                <TextView
                    android:id="@+id/emptyText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:tag="text2"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/btnEmptyPick"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="20dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="28dp"
                    android:paddingEnd="28dp"
                    android:tag="pill accent"
                    android:text="Escolher pasta"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <!-- Mini player -->
        <LinearLayout
            android:id="@+id/miniPlayer"
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="8dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="9dp"
            android:paddingEnd="6dp"
            android:tag="pill"
            android:visibility="gone">

            <ImageView
                android:id="@+id/miniArt"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:clipToOutline="true"
                android:importantForAccessibility="no"
                android:scaleType="centerInside"
                android:tag="art:24" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/miniTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:tag="text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/miniArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:tag="text2"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/miniPlayPause"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@null"
                android:contentDescription="Play/Pause"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_play"
                android:tag="flat icon" />

            <ImageButton
                android:id="@+id/miniNext"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@null"
                android:contentDescription="Próxima"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_next"
                android:tag="flat icon" />
        </LinearLayout>
    </LinearLayout>

    <!-- Tocando agora -->
    <FrameLayout
        android:id="@+id/nowPlaying"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <com.example.vortex_player.AmbientView
            android:id="@+id/npAmbient"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fitsSystemWindows="true"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="12dp">

            <FrameLayout
                android:id="@+id/btnClose"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:clickable="true"
                android:contentDescription="Fechar"
                android:focusable="true">

                <View
                    android:layout_width="40dp"
                    android:layout_height="5dp"
                    android:layout_gravity="center"
                    android:tag="grabber" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp"
                android:layout_weight="1">

                <com.example.vortex_player.SquareImageView
                    android:id="@+id/npArt"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:clipToOutline="true"
                    android:importantForAccessibility="no"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_music"
                    android:tag="art:28 rim:28" />

                <FrameLayout
                    android:id="@+id/lyricsPanel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:tag="glass:28"
                    android:visibility="gone">

                    <ScrollView
                        android:id="@+id/lyricsScroll"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fadingEdgeLength="56dp"
                        android:overScrollMode="never"
                        android:requiresFadingEdge="vertical"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/lyricsLines"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="22dp"
                            android:paddingTop="28dp"
                            android:paddingEnd="22dp"
                            android:paddingBottom="160dp" />
                    </ScrollView>

                    <LinearLayout
                        android:id="@+id/lyricsStatus"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="24dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/lyricsMessage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:tag="text2"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/lyricsRetry"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginTop="14dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingStart="22dp"
                            android:paddingEnd="22dp"
                            android:tag="pill text"
                            android:text="Tentar de novo"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:tag="pill">

                        <LinearLayout
                            android:id="@+id/lyricsOffsetGroup"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/lyricsMinus"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:clickable="true"
                                android:contentDescription="Atrasar letra meio segundo"
                                android:focusable="true"
                                android:gravity="center"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:tag="flat text"
                                android:text="−0,5s"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/lyricsOffsetLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:minWidth="52dp"
                                android:tag="text2"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/lyricsPlus"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:clickable="true"
                                android:contentDescription="Adiantar letra meio segundo"
                                android:focusable="true"
                                android:gravity="center"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:tag="flat text"
                                android:text="+0,5s"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <ImageButton
                            android:id="@+id/lyricsSearch"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@null"
                            android:contentDescription="Buscar outra letra"
                            android:padding="10dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_search"
                            android:tag="flat icon" />
                    </LinearLayout>
                </FrameLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/npTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:tag="text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/npArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:tag="text2"
                android:textSize="18sp" />

            <SeekBar
                android:id="@+id/npSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:maxHeight="4dp"
                android:minHeight="4dp"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:splitTrack="false" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:paddingStart="7dp"
                android:paddingEnd="7dp">

                <TextView
                    android:id="@+id/npCurrent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:tag="text2"
                    android:text="0:00"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/npRemaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="text2"
                    android:text="-0:00"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:tag="pill">

                <ImageButton
                    android:id="@+id/npPrevious"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@null"
                    android:contentDescription="Anterior"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_previous"
                    android:tag="flat icon" />

                <ImageButton
                    android:id="@+id/npPlayPause"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:layout_marginStart="30dp"
                    android:layout_marginEnd="30dp"
                    android:background="@null"
                    android:contentDescription="Play/Pause"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_play"
                    android:tag="flat icon" />

                <ImageButton
                    android:id="@+id/npNext"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@null"
                    android:contentDescription="Próxima"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_next"
                    android:tag="flat icon" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_volume_down"
                    android:tag="icon2" />

                <SeekBar
                    android:id="@+id/npVolume"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxHeight="4dp"
                    android:minHeight="4dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:splitTrack="false" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_volume_up"
                    android:tag="icon2" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnLyrics"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@null"
                android:contentDescription="Letra"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_lyrics"
                android:tag="pill icon" />

            <LinearLayout
                android:id="@+id/btnOutput"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:tag="pill">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_output"
                    android:tag="iconAccent" />

                <TextView
                    android:id="@+id/npOutputName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:tag="text"
                    android:text="Este celular"
                    android:textSize="14sp" />
            </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Painel inferior (configurações e saída de áudio) -->
    <FrameLayout
        android:id="@+id/sheetOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View
            android:id="@+id/sheetScrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:contentDescription="Fechar"
            android:focusable="true" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fitsSystemWindows="true">

            <LinearLayout
                android:id="@+id/sheetPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_margin="10dp"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingTop="10dp"
                android:paddingEnd="22dp"
                android:paddingBottom="22dp"
                android:tag="sheet">

                <View
                    android:layout_width="40dp"
                    android:layout_height="5dp"
                    android:layout_gravity="center_horizontal"
                    android:tag="grabber" />

                <TextView
                    android:id="@+id/sheetTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:tag="text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:id="@+id/sheetContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" />
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
